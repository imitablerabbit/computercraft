# The build program on flat ground: a turtle with a chest of materials
# behind it, in front of where the example hut (blueprints/hut.lua) goes.
name Build
description A turtle on a flat plot with a chest of cobblestone, oak planks and glass behind it, and a little coal.
description The plot is straight ahead and to the right. Try: build hut (or build hut behind clear, or build hut behind false check).

ground -8 -8 10 12 0 3 ores=false pockets=false
block 0 -1 1 chest
items 0 -1 1 cobblestone*64 oak_planks*32 glass*4 dirt*20

# Two blocks in the way: dirt where the front wall goes and dirt in
# the middle of the floor. build leaves them; build hut behind clear
# digs them out.
block 1 1 1 dirt
block 2 3 1 dirt

turtle 3 label=Builder
  pos 0 0 1
  heading north
  fuel 1000
  slots coal*4
  peripheral left modem

# The hut is 5x5 at x 0..4, y 1..5 (the front row is y 1), walls from
# z 1 to 3 with a door gap at x 2 and glass in the side walls at y 3,
# and a plank roof at z 4.
check build puts up the hut from the chest around what is in the way
  run build hut
  seconds 600
  until done:
  expect turtle 3 pos 0 0 1
  expect turtle 3 heading north
  expect blocks 0 1 1 4 5 3 cobblestone = 43
  expect block 1 1 1 dirt
  expect block 2 3 1 dirt
  expect blocks 0 1 4 4 5 4 planks
  expect block 0 3 2 glass
  expect block 4 3 2 glass
  expect blocks 2 1 1 2 1 2 air
  expect block 2 1 3 cobblestone
  expect blocks 1 2 2 3 4 3 air
  expect chest 0 -1 1 item cobblestone = 21
  expect chest 0 -1 1 item oak_planks = 7
  expect chest 0 -1 1 item glass = 2
  expect chest 0 -1 1 item dirt = 20
  expect turtle 3 item coal = 4
  expect screen 3 done: placed 70 blocks, 1 blocked
  expect no-error

check build with clear digs out what is in the way
  run build hut behind clear
  seconds 600
  until done:
  expect turtle 3 pos 0 0 1
  expect blocks 0 1 1 4 5 3 cobblestone = 44
  expect blocks 1 2 1 3 4 3 air
  expect blocks 0 1 4 4 5 4 planks
  expect chest 0 -1 1 item cobblestone = 20
  expect screen 3 done: placed 71 blocks
  expect no-error

check build check refuses when materials are missing
  run build watchtower behind false check
  seconds 10
  expect screen 3 oak_log (have 0)
  expect screen 3 not starting: materials missing
  expect turtle 3 fuel = 1000
  expect block 0 1 1 air

check build without check starts and asks for what is missing
  run build watchtower
  seconds 60
  expect screen 3 Missing:
  expect screen 3 Needs help: missing
  expect log Needs help: missing 28 oak_log
  expect block 0 1 1 air
