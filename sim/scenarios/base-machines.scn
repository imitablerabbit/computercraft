# The machines dashboard: an energy cell on each side of the computer,
# and over a wired network a lava tank, another cell and a chest. The
# cells drift up and down slowly; the left one starts at 46% and runs
# down past 20% after about 25 s, the right one starts at 11% and fills
# past 90% after about 80 s, and the networked one runs low at about
# 78 s. A lamp on top stands in for a generator
# switched by the low energy rule.
name Machines dashboard
description A computer with energy cells left and right, a wired modem on its back to a lava tank, a third cell and a chest, a lamp on top (the "generator"), a wireless modem underneath and a 3x2 monitor (monitor_0). A pocket computer runs the pager.
description At 1 s the timeline adds the rule: energy below 20% clear at 90% switches the top output on. The right cell is low from the start and recovers at about 80 s; the left one runs low at about 25 s.

ground -6 -6 6 6 0 3 ores=false pockets=false
block -1 0 1 energy_cell
block 1 0 1 energy_cell
block 0 0 2 redstone_lamp
block -2 -3 1 tank network=factory
block 3 -3 1 energy_cell network=factory
block 2 -3 1 chest network=factory
items 2 -3 1 coal*64 coal*64 iron_ingot*20 redstone*12
fill 0 -1 1 0 -2 1 cable
fill -2 -2 1 3 -2 1 cable

computer 1 Machines
  pos 0 0 1
  heading north
  peripheral back modem wired=true network=factory
  peripheral monitor_0 monitor size=3x2 at=-2,3,1
  peripheral bottom modem
  autorun machines monitor_0

# A pocket pager that hears the alerts over the bus.
pocket 10 label=Pager
  peripheral back modem
  autorun pager

at 1 type 1 rule energy below 20 clear 90 top
at 2 type 1 capacity tank 16000
at 3 type 1 show tank

check low energy raises a power alert and switches the generator on
  seconds 32
  expect log rule 1: energy below 20%, clear at 90%, output top
  expect log ALERT power: right energy low
  expect log left energy low
  expect log output top on
  expect screen 1 2 alerts
  expect screen 10 Machine power
  expect log fluid_tank_0 holds 16000 mB
  expect screen 1 tanks
  expect no-error

check a recovered cell clears its alert but the generator stays on for the other
  seconds 90
  expect log right energy back to
  expect log ALERT power: left energy low: 19%; energy_cell_0 energy low
  expect not log output top off
  expect screen 1 2 alerts
  expect no-error
