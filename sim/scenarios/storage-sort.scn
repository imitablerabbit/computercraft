# The storage program with its input chest touching the computer (on
# its left) as well as on the cable, so the computer sees that chest
# twice: as left and as minecraft:chest_3. Three storage chests hold
# partial stacks scattered about. The timeline deposits the input chest,
# sorts the chests from the Settings tab, then searches for coal with
# the on-screen keyboard.
name Storage sort
description A storage computer whose input chest (minecraft:chest_3) is right next to it, on its left, and also on the cable; three storage chests of scattered partial stacks; an output chest (minecraft:chest_4).
description The timeline deposits at 5 s, presses Sort chests on the Settings tab at 9 s (everything ends up in the first chest, in name order), then at 20 s touches the search box and types coal on the on-screen keyboard.

ground -8 -8 8 8 0 3 ores=false pockets=false

block -2 -3 1 chest network=storage
items -2 -3 1 dirt*20 coal*10 torch*30
block -1 -3 1 chest network=storage
items -1 -3 1 cobblestone*50 dirt*20 coal*40
block 0 -3 1 chest network=storage
items 0 -3 1 torch*40 cobblestone*64 oak_log*12 coal*5

# input (chest_3), touching the computer's left side, and output (chest_4)
block -1 0 1 chest network=storage
items -1 0 1 coal*45 cobblestone*36 oak_log*18
block 2 2 1 chest network=storage

fill 0 -1 1 0 -2 1 cable
fill -2 -2 1 0 -2 1 cable

computer 1 Storage
  pos 0 0 1
  heading north
  peripheral back modem wired=true network=storage
  peripheral right monitor size=3x2 at=1,0,1
  autorun storage right minecraft:chest_3 minecraft:chest_4

at 5 type 1 deposit
at 8 touch 1 Settings
at 9 touch 1 "Sort chests"
at 18 touch 1 Items
at 20 touch 1 8 4
at 21 touch 1 c
at 21.5 touch 1 o
at 22 touch 1 a
at 22.5 touch 1 l
at 23 touch 1 Done

check deposit from a chest beside the computer, sort, and search on the keyboard
  seconds 25
  expect chest -1 0 1 items = 0
  expect log Deposited 99 items
  expect log Sorted:
  expect chest -2 -3 1 items = 390
  expect chest -2 -3 1 item coal = 100
  expect chest -1 -3 1 items = 0
  expect chest 0 -3 1 items = 0
  expect screen 1 coal
  expect no-error
