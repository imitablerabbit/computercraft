# The scan program: a hut like blueprints/hut.lua stands in front of
# the turtle, which scans it into a blueprint, walks to the empty plot
# to the east with goto and builds a copy there from the chest.
name Scan and copy
description A cobblestone hut in front of a turtle, and an empty plot with a chest of materials 8 blocks east.
description The turtle scans the hut (scan copy 5 5 4), then the timeline types goto 8 0 0 north and build copy to put up a copy on the plot.

ground -8 -8 16 12 0 3 ores=false pockets=false

# The hut: x 0..4, y 1..5 (front row y 1), walls z 1..3, roof z 4.
fill 0 1 1 4 5 3 cobblestone
fill 1 2 1 3 4 3 air
clear 2 1 1 2 1 2
block 0 3 2 glass
block 4 3 2 glass
fill 0 1 4 4 5 4 planks

# The plot for the copy, with its chest behind the build start.
block 8 -1 1 chest
items 8 -1 1 cobblestone*64 oak_planks*32 glass*4

turtle 3 label=Scanner
  pos 0 0 1
  heading north
  fuel 1000
  peripheral left modem
  autorun scan copy 5 5 4

# There is no gps here, so goto counts from where the turtle started:
# 8 blocks east is x 8, and it faces north again at the end.
at 400 type 3 "goto 8 0 0 north"
at 430 type 3 "build copy"

check scan sees the whole hut and comes back
  run scan hut2 5 5 4
  seconds 400
  until done: scanned
  expect turtle 3 pos 0 0 1
  expect turtle 3 heading north
  expect screen 3 44 cobblestone
  expect screen 3 2 glass
  expect screen 3 25 oak_planks
  expect screen 3 saved /blueprints/hut2.lua: 71 blocks
  expect blocks 0 1 1 4 5 3 cobblestone = 44
  expect no-error

check scan then build makes a copy of the hut
  seconds 900
  until done: placed
  expect turtle 3 pos 8 0 1
  expect blocks 8 1 1 12 5 3 cobblestone = 44
  expect blocks 8 1 4 12 5 4 planks
  expect block 8 3 2 glass
  expect block 12 3 2 glass
  expect blocks 9 2 1 11 4 3 air
  expect blocks 10 1 1 10 1 2 air
  expect screen 3 done: placed 71 blocks
  expect no-error
